---
// 하울링 고리: 마이크 → 믹서·앰프 → 스피커 → 공기 → 다시 마이크.
const nodes = [
  { a: -90, t: '마이크' },
  { a: 0, t: '믹서·앰프' },
  { a: 90, t: '스피커' },
  { a: 180, t: '공기' },
];
const C = 130;
const R = 84;
const p = (deg: number, r = R) => ({ x: C + r * Math.cos((deg * Math.PI) / 180), y: C + r * Math.sin((deg * Math.PI) / 180) });
const arc = (a0: number, a1: number) => {
  const s = p(a0);
  const e = p(a1);
  return `M${s.x},${s.y} A${R},${R} 0 0 1 ${e.x},${e.y}`;
};
---

<figure class="loop">
  <svg viewBox="0 0 260 260" role="img" aria-label="하울링 고리">
    <defs>
      <marker id="fb-arrow" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0 L10 5 L0 10 z" fill="#f04452"></path>
      </marker>
    </defs>
    {nodes.map((n) => <path d={arc(n.a + 22, n.a + 68)} stroke="#f04452" stroke-width="3" fill="none" marker-end="url(#fb-arrow)" />)}
    {
      nodes.map((n) => {
        const q = p(n.a);
        return (
          <g>
            <rect x={q.x - 40} y={q.y - 17} width="80" height="34" rx="17" fill="#fff" stroke="#e5e8eb" />
            <text x={q.x} y={q.y + 5} text-anchor="middle" font-size="13" font-weight="700" fill="#191f28">
              {n.t}
            </text>
          </g>
        );
      })
    }
    <text x={C} y={C - 4} text-anchor="middle" font-size="22" font-weight="800" fill="#f04452">삐—</text>
    <text x={C} y={C + 18} text-anchor="middle" font-size="11" fill="#4e5968">돌 때마다 커진다</text>
  </svg>
  <figcaption>이 고리를 끊거나 약하게 만들면 하울링이 줄어든다.</figcaption>
</figure>

<style>
  .loop {
    margin: 0 0 16px;
    padding: 12px 16px 16px;
    border-radius: var(--radius-l);
    background: var(--red-soft);
    text-align: center;
  }
  svg {
    width: 100%;
    max-width: 280px;
  }
  figcaption {
    color: var(--muted);
    font-size: 14px;
  }
</style>
