---
// 주파수 지도: 20 Hz~20 kHz 로그 눈금 위에 느낌 표현 대역과 목소리 기본음을 놓는다.
// 대역 수치는 1장 주파수 레슨의 출처(QSC, ESTA, Wikipedia Voice frequency, 확인 2026-10-20)를 따른다.
interface Props {
  /** 강조할 줄 id: muddy | warm | clear | male | female */
  mark?: string[];
  /** 목소리 기본음 줄을 보여 줄지 */
  voice?: boolean;
}
const { mark = [], voice = true } = Astro.props;
const x = (f: number) => (Math.log10(f / 20) / 3) * 100;
const rows = [
  { id: 'muddy', name: '웅웅·둔탁', from: 20, to: 100, c: '#8b95a1', note: '100 Hz 아래' },
  { id: 'warm', name: '따뜻함·몸통', from: 200, to: 500, c: '#fe8c00', note: '200~500 Hz' },
  { id: 'clear', name: '또렷함', from: 2000, to: 4000, c: '#3182f6', note: '2~4 kHz' },
];
const voices = [
  { id: 'male', name: '남성 말소리 기본음', from: 90, to: 155, c: '#0a9f5c', note: '90~155 Hz' },
  { id: 'female', name: '여성 말소리 기본음', from: 165, to: 255, c: '#0a9f5c', note: '165~255 Hz' },
];
const grid = [
  { f: 20, t: '20' },
  { f: 100, t: '100' },
  { f: 1000, t: '1k' },
  { f: 10000, t: '10k' },
  { f: 20000, t: '20k' },
];
const all = voice ? [...rows, ...voices] : rows;
---

<figure class="fmap">
  <div class="ends">
    <span>낮은 소리 <small>쿵·웅</small></span>
    <span>높은 소리 <small>치익·ㅅ</small></span>
  </div>
  <div class="plot">
    {grid.map((g) => <i class="gl" style={`left:${x(g.f)}%`} />)}
    {
      all.map((r) => (
        <div class:list={['row', { dim: mark.length > 0 && !mark.includes(r.id) }]}>
          <span class="bar" style={`left:${x(r.from)}%;width:${Math.max(3, x(r.to) - x(r.from))}%;background:${r.c}`} />
          <span class="lab" style={`left:${Math.min(x(r.from), 58)}%`}>
            <strong>{r.name}</strong> {r.note}
          </span>
        </div>
      ))
    }
  </div>
  <div class="axis">
    {grid.map((g) => <span style={`left:${x(g.f)}%`}>{g.t}</span>)}
  </div>
  <figcaption>가로축은 주파수(Hz). 사람이 듣는 범위는 대략 20 Hz~20 kHz다.</figcaption>
</figure>

<style>
  .fmap {
    margin: 0 0 16px;
    padding: 16px;
    border-radius: var(--radius-l);
    background: var(--bg-grey);
  }
  .ends {
    display: flex;
    justify-content: space-between;
    margin-bottom: 10px;
    font-size: 14px;
    font-weight: 700;
  }
  .ends small {
    color: var(--faint);
    font-weight: 600;
  }
  .plot {
    position: relative;
    padding: 4px 0;
    border-radius: 12px;
    background: #fff;
  }
  .gl {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--line);
  }
  .row {
    position: relative;
    height: 46px;
    transition: opacity 0.2s;
  }
  .row.dim {
    opacity: 0.25;
  }
  .bar {
    position: absolute;
    top: 6px;
    height: 12px;
    border-radius: 6px;
  }
  .lab {
    position: absolute;
    top: 21px;
    white-space: nowrap;
    font-size: 13px;
    color: var(--muted);
    padding-left: 2px;
  }
  .lab strong {
    color: var(--text);
  }
  .axis {
    position: relative;
    height: 22px;
    color: var(--faint);
    font-size: 12px;
  }
  .axis span {
    position: absolute;
    top: 4px;
    transform: translateX(-50%);
  }
  .axis span:first-child {
    transform: none;
  }
  .axis span:last-child {
    transform: translateX(-100%);
  }
  figcaption {
    color: var(--faint);
    font-size: 13px;
  }
</style>
