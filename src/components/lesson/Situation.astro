---
// 레슨 첫 카드의 현장 장면. 말풍선 하나(quote)와 짧은 설명(slot).
interface Props {
  /** 장면 이름(예: 주일 아침 리허설) */
  scene: string;
  /** 누가 한 말 */
  who?: string;
  quote?: string;
}
const { scene, who, quote } = Astro.props;
---

<div class="situation">
  <div class="scene">
    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2"></circle><path d="M12 7v5l3 2" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
    {scene}
  </div>
  {
    quote && (
      <div class="bubble-row">
        <span class="avatar" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="22" height="22"><circle cx="12" cy="9" r="4" fill="currentColor" /><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6" fill="currentColor" /></svg>
        </span>
        <div class="bubble">
          {who && <small>{who}</small>}
          <p>{quote}</p>
        </div>
      </div>
    )
  }
  <div class="desc"><slot /></div>
</div>

<style>
  .situation {
    margin: 0 0 16px;
    padding: 18px;
    border-radius: var(--radius-l);
    background: var(--bg-grey);
  }
  .scene {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--muted);
    font-size: 14px;
    font-weight: 700;
  }
  .bubble-row {
    display: flex;
    gap: 10px;
    align-items: flex-end;
    margin-top: 12px;
  }
  .avatar {
    flex: none;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #dfe3e8;
    color: #8b95a1;
  }
  .bubble {
    position: relative;
    padding: 12px 16px;
    border-radius: 20px 20px 20px 6px;
    background: #fff;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
  }
  .bubble small {
    display: block;
    color: var(--faint);
    font-size: 13px;
    font-weight: 600;
  }
  .bubble p {
    margin: 0;
    color: var(--text);
    font-size: 18px;
    font-weight: 700;
    line-height: 1.45;
  }
  .desc {
    margin-top: 12px;
  }
  .desc :global(p) {
    margin: 0;
    color: var(--text-2);
  }
  .desc :global(p + p) {
    margin-top: 8px;
  }
</style>
