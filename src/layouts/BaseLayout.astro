---
import '../styles/tokens.css';
import { SITE_NAME } from '../lib/release';
import { DEFAULT_OG_IMAGE, OG_IMAGE_ALT, SITE_DESCRIPTION, jsonLdGraph } from '../lib/seo';

interface Props {
  title: string;
  /** 탭 제목을 통째로 정할 때(홈). 없으면 "{title} · 사이트 이름" */
  fullTitle?: string;
  description?: string;
  /** 레슨처럼 자기 상단 바를 쓰는 화면은 사이트 머리·꼬리를 숨긴다 */
  bare?: boolean;
  /** 본문 최대 폭 */
  width?: 'narrow' | 'wide';
  /** 공유 미리보기 이미지(사이트 루트 기준 경로, 1200×630). 없으면 기본 이미지 */
  image?: string;
  ogType?: 'website' | 'article';
  /** 구조화 데이터 노드. @context는 레이아웃이 붙인다 */
  jsonLd?: Record<string, unknown>[];
}
const {
  title,
  fullTitle,
  description = SITE_DESCRIPTION,
  bare = false,
  width = 'narrow',
  image = DEFAULT_OG_IMAGE,
  ogType = 'website',
  jsonLd = [],
} = Astro.props;
const pageTitle = fullTitle ?? `${title} · ${SITE_NAME}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);
---

<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#ffffff" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={OG_IMAGE_ALT} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    {jsonLd.length > 0 && <script type="application/ld+json" set:html={jsonLdGraph(jsonLd)} />}
  </head>
  <body>
    {
      !bare && (
        <header class="site-header">
          <div class="site-header-in">
            <a class="brand" href="/">
              <span class="brand-mark" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="22" height="22">
                  <rect x="3" y="9" width="3" height="6" rx="1.5" fill="currentColor" />
                  <rect x="8.5" y="5" width="3" height="14" rx="1.5" fill="currentColor" />
                  <rect x="14" y="7" width="3" height="10" rx="1.5" fill="currentColor" />
                  <rect x="19.5" y="10" width="3" height="4" rx="1.5" fill="currentColor" />
                </svg>
              </span>
              {SITE_NAME}
            </a>
            <nav>
              <a href="/">코스</a>
              <a href="/lab/">실습실</a>
            </nav>
          </div>
        </header>
      )
    }
    <main class:list={['site-main', `is-${width}`, { 'is-bare': bare }]}><slot /></main>
    {
      !bare && (
        <footer class="site-footer">
          <a href="/credits/">음원 출처</a>
          <span>무료 학습 사이트 · 로그인 없음</span>
        </footer>
      )
    }
  </body>
</html>

<style is:global>
  .site-main {
    margin: 0 auto;
    padding: 8px 20px 64px;
  }
  .site-main.is-narrow {
    max-width: 680px;
  }
  .site-main.is-wide {
    max-width: 1120px;
  }
  .site-main.is-bare {
    padding: 0;
    max-width: none;
  }
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: saturate(180%) blur(12px);
    -webkit-backdrop-filter: saturate(180%) blur(12px);
  }
  .site-header-in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    max-width: 1120px;
    height: 60px;
    margin: 0 auto;
    padding: 0 20px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 800;
    font-size: 18px;
    color: var(--text);
    text-decoration: none;
    letter-spacing: -0.02em;
  }
  .brand-mark {
    display: inline-grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 10px;
    background: var(--accent);
    color: #fff;
  }
  .brand-mark svg {
    width: 20px;
    height: 20px;
  }
  .site-header nav {
    display: flex;
    gap: 4px;
  }
  .site-header nav a {
    padding: 8px 12px;
    border-radius: var(--radius-s);
    color: var(--muted);
    font-weight: 600;
    font-size: 15px;
    text-decoration: none;
  }
  .site-header nav a:hover {
    background: var(--bg-grey);
  }
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    max-width: 680px;
    margin: 0 auto;
    padding: 24px 20px 48px;
    color: var(--faint);
    font-size: 14px;
  }
  .site-footer a {
    color: var(--muted);
  }
</style>
