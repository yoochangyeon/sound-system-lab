---
import '../styles/tokens.css';
import { SITE_NAME } from '../lib/release';

interface Props {
  title: string;
  description?: string;
  /** 레슨처럼 자기 상단 바를 쓰는 화면은 사이트 머리·꼬리를 숨긴다 */
  bare?: boolean;
  /** 본문 최대 폭 */
  width?: 'narrow' | 'wide';
}
const { title, description, bare = false, width = 'narrow' } = Astro.props;
---

<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {description && <meta name="description" content={description} />}
    <title>{title} · {SITE_NAME}</title>
  </head>
  <body>
    {
      !bare && (
        <header class="site-header">
          <div class="site-header-in">
            <a class="brand" href="/">
              <span class="brand-mark" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="22" height="22">
                  <rect x="3" y="9" width="3" height="6" rx="1.5" fill="currentColor" />
                  <rect x="8.5" y="5" width="3" height="14" rx="1.5" fill="currentColor" />
                  <rect x="14" y="7" width="3" height="10" rx="1.5" fill="currentColor" />
                  <rect x="19.5" y="10" width="3" height="4" rx="1.5" fill="currentColor" />
                </svg>
              </span>
              {SITE_NAME}
            </a>
            <nav>
              <a href="/">코스</a>
              <a href="/lab/">실습실</a>
            </nav>
          </div>
        </header>
      )
    }
    <main class:list={['site-main', `is-${width}`, { 'is-bare': bare }]}><slot /></main>
    {
      !bare && (
        <footer class="site-footer">
          <a href="/credits/">음원 출처</a>
          <span>무료 학습 사이트 · 로그인 없음</span>
        </footer>
      )
    }
  </body>
</html>

<style is:global>
  .site-main {
    margin: 0 auto;
    padding: 8px 20px 64px;
  }
  .site-main.is-narrow {
    max-width: 680px;
  }
  .site-main.is-wide {
    max-width: 1120px;
  }
  .site-main.is-bare {
    padding: 0;
    max-width: none;
  }
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: saturate(180%) blur(12px);
    -webkit-backdrop-filter: saturate(180%) blur(12px);
  }
  .site-header-in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    max-width: 1120px;
    height: 60px;
    margin: 0 auto;
    padding: 0 20px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 800;
    font-size: 18px;
    color: var(--text);
    text-decoration: none;
    letter-spacing: -0.02em;
  }
  .brand-mark {
    display: inline-grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 10px;
    background: var(--accent);
    color: #fff;
  }
  .brand-mark svg {
    width: 20px;
    height: 20px;
  }
  .site-header nav {
    display: flex;
    gap: 4px;
  }
  .site-header nav a {
    padding: 8px 12px;
    border-radius: var(--radius-s);
    color: var(--muted);
    font-weight: 600;
    font-size: 15px;
    text-decoration: none;
  }
  .site-header nav a:hover {
    background: var(--bg-grey);
  }
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    max-width: 680px;
    margin: 0 auto;
    padding: 24px 20px 48px;
    color: var(--faint);
    font-size: 14px;
  }
  .site-footer a {
    color: var(--muted);
  }
</style>
