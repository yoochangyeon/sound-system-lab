---
// 음원 출처(기획서 S09). 곡 매니페스트에서 만든다(#45). public/audio/SOURCES.md와 같은 내용을 유지한다.
import BaseLayout from '../layouts/BaseLayout.astro';
import { SONGS } from '../audio/library';
---

<BaseLayout title="음원 출처">
  <h1>음원 출처</h1>
  <p>이 사이트의 실습 음원은 이용 조건을 확인한 멀티트랙만 씁니다. 교육 목적의 무료 사이트이며 상업적으로 쓰지 않습니다.</p>

  {
    SONGS.map((song) => (
      <section>
        <h2>
          {song.artist} — "{song.title}"
        </h2>
        <table>
          <tbody>
            <tr>
              <th>출처</th>
              <td>
                <a href={song.source.url}>{song.source.name}</a>
              </td>
            </tr>
            <tr>
              <th>만든 사람</th>
              <td>
                {song.artist}
                {song.credit.artistUrl && (
                  <>
                    {' '}
                    (<a href={song.credit.artistUrl}>밴드 페이지</a>)
                  </>
                )}
                . {song.credit.thanks} <a href={song.credit.listingUrl}>라이브러리 항목</a>
              </td>
            </tr>
            <tr>
              <th>이용 조건</th>
              <td>
                {song.terms.summary} <a href={song.terms.url}>자세히</a>
              </td>
            </tr>
            <tr>
              <th>바꾼 점</th>
              <td>{song.changes}</td>
            </tr>
            <tr>
              <th>소스</th>
              <td>{song.stems.map((s) => `${s.label}(${s.from})`).join(', ')}</td>
            </tr>
            {song.reference && (
              <tr>
                <th>정답 믹스</th>
                <td>{song.reference.note}</td>
              </tr>
            )}
          </tbody>
        </table>
      </section>
    ))
  }
</BaseLayout>

<style>
  h1 {
    margin: 24px 0 8px;
    font-size: 30px;
    letter-spacing: -0.03em;
  }
  h2 {
    margin: 32px 0 12px;
    font-size: 20px;
  }
  p {
    color: var(--muted);
  }
  table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    border-radius: var(--radius);
    background: var(--bg-grey);
    overflow: hidden;
    font-size: 15px;
  }
  th,
  td {
    padding: 12px 14px;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid #e5e8eb;
  }
  tr:last-child th,
  tr:last-child td {
    border-bottom: 0;
  }
  th {
    width: 84px;
    color: var(--faint);
    font-weight: 700;
    white-space: nowrap;
  }
  td {
    color: var(--text);
    word-break: break-word;
  }
</style>
