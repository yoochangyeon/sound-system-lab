---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CHAPTERS, lessonHref, sortedLessons } from '../lib/lessons';
import { QUIZZES } from '../quizzes';
import { MISSIONS } from '../missions';
import { SITE_NAME } from '../lib/release';
import { SITE_DESCRIPTION, SITE_TAGLINE, courseJsonLd, websiteJsonLd } from '../lib/seo';

const lessons = await sortedLessons();
const first = lessons[0];
const site = Astro.site!;
const jsonLd = [
  websiteJsonLd(site),
  courseJsonLd(
    site,
    lessons.map((l) => ({ title: l.data.title, url: new URL(lessonHref(l), site).href })),
  ),
];
---

<BaseLayout title="코스" fullTitle={`${SITE_NAME} · ${SITE_TAGLINE}`} description={SITE_DESCRIPTION} jsonLd={jsonLd}>
  <section class="hero">
    <p class="eyebrow">교회 방송실 봉사자를 위한 무료 코스</p>
    <h1>만지고 들으며<br />배우는 방송실 음향</h1>
    <p class="lead">하울링이 나거나 설교가 웅웅거릴 때 무엇을 만질지, 카드를 넘기며 그림으로 보고 소리로 확인해요.</p>
    <div class="hero-stats">
      <div><strong>{lessons.length}</strong><span>레슨</span></div>
      <div><strong>{QUIZZES.length}</strong><span>실전 퀴즈</span></div>
      <div><strong>{MISSIONS.length}</strong><span>실전 미션</span></div>
    </div>
    <a class="btn hero-cta" href={lessonHref(first)}>1장부터 시작하기</a>
  </section>

  {
    CHAPTERS.map((ch) => {
      const items = lessons.filter((l) => l.data.chapter === ch.key);
      return (
        <section class="chapter" id={ch.key}>
          <header class="chapter-head">
            <span class={`chapter-no is-${ch.no}`}>{ch.no}</span>
            <div>
              <h2>{ch.name}</h2>
              <p>{ch.blurb}</p>
            </div>
          </header>
          <ol class="lesson-list">
            {items.map((l, i) => (
              <li>
                <a class="lesson-card" href={lessonHref(l)}>
                  <span class="lesson-idx">{i + 1}</span>
                  <span class="lesson-text">
                    <strong>{l.data.title}</strong>
                    <small>{l.data.summary}</small>
                    {l.data.topics.length > 0 && (
                      <span class={`keys is-${ch.no}`}>
                        <b>핵심</b> {l.data.topics.join(' · ')}
                      </span>
                    )}
                  </span>
                  <span class="chev" aria-hidden="true">›</span>
                </a>
              </li>
            ))}
          </ol>
        </section>
      );
    })
  }

  <a class="lab-card" href="/lab/">
    <div>
      <p class="eyebrow is-light">실습실</p>
      <h2>쉬운 믹서로 미션 풀기</h2>
      <p>{MISSIONS.slice(0, 3).map((m) => m.title).join(', ')} 등 미션 {MISSIONS.length}개</p>
    </div>
    <svg class="lab-art" viewBox="0 0 120 80" aria-hidden="true">
      {
        [0, 1, 2, 3, 4].map((i) => (
          <g>
            <rect x={10 + i * 22} y="8" width="4" height="64" rx="2" fill="rgba(255,255,255,0.35)" />
            <rect x={4 + i * 22} y={[40, 22, 48, 30, 36][i]} width="16" height="10" rx="4" fill="#fff" />
          </g>
        ))
      }
    </svg>
  </a>
</BaseLayout>

<style>
  .hero {
    padding: 28px 0 12px;
  }
  .eyebrow {
    margin: 0 0 8px;
    color: var(--accent);
    font-weight: 700;
    font-size: 15px;
  }
  .eyebrow.is-light {
    color: rgba(255, 255, 255, 0.85);
  }
  .hero h1 {
    margin: 0;
    font-size: clamp(30px, 8vw, 40px);
    line-height: 1.3;
    letter-spacing: -0.03em;
    font-weight: 800;
  }
  .lead {
    margin: 14px 0 0;
    color: var(--muted);
    font-size: 17px;
  }
  .hero-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
    margin: 24px 0;
  }
  .hero-stats div {
    padding: 14px 8px;
    border-radius: var(--radius);
    background: var(--bg-grey);
    text-align: center;
  }
  .hero-stats strong {
    display: block;
    font-size: 24px;
    font-weight: 800;
    color: var(--text);
  }
  .hero-stats span {
    color: var(--muted);
    font-size: 14px;
  }
  .hero-cta {
    width: 100%;
  }
  .chapter {
    margin-top: 40px;
    /* 경로 표시(/#basics)로 들어오면 고정 머리말에 가리지 않게 */
    scroll-margin-top: 72px;
  }
  .chapter-head {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 12px;
  }
  .chapter-no {
    flex: none;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 14px;
    font-weight: 800;
    font-size: 20px;
  }
  .chapter-no.is-1 {
    background: var(--accent-soft);
    color: var(--accent);
  }
  .chapter-no.is-2 {
    background: #fff3e0;
    color: var(--fn-dyn);
  }
  .chapter-no.is-3 {
    background: var(--green-soft);
    color: var(--green);
  }
  .chapter-head h2 {
    margin: 0;
    font-size: 22px;
    letter-spacing: -0.02em;
  }
  .chapter-head p {
    margin: 0;
    color: var(--faint);
    font-size: 14px;
    line-height: 1.4;
  }
  .lesson-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }
  .lesson-card {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px;
    border-radius: var(--radius);
    background: var(--surface-2);
    border: 1px solid var(--line);
    color: var(--text);
    text-decoration: none;
    transition: background 0.15s;
  }
  .lesson-card:hover {
    background: var(--bg-grey);
  }
  .lesson-idx {
    flex: none;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: #fff;
    border: 1px solid var(--line-2);
    color: var(--muted);
    font-size: 14px;
    font-weight: 700;
  }
  .lesson-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
    flex: 1;
  }
  .lesson-text strong {
    font-size: 16px;
    line-height: 1.45;
  }
  .lesson-text small {
    color: var(--faint);
    font-size: 14px;
    line-height: 1.45;
    margin-top: 2px;
  }
  .keys {
    margin-top: 6px;
    font-size: 13px;
    font-weight: 600;
    color: var(--muted);
  }
  .keys b {
    margin-right: 2px;
    font-weight: 800;
  }
  .keys.is-1 b {
    color: var(--accent);
  }
  .keys.is-2 b {
    color: #d97400;
  }
  .keys.is-3 b {
    color: var(--green);
  }
  .chev {
    color: var(--faint);
    font-size: 24px;
  }
  .lab-card {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 40px;
    padding: 24px;
    border-radius: var(--radius-l);
    background: linear-gradient(135deg, #3182f6, #1b64da);
    color: #fff;
    text-decoration: none;
    overflow: hidden;
  }
  .lab-card h2 {
    margin: 0;
    font-size: 22px;
  }
  .lab-card p:last-child {
    margin: 6px 0 0;
    opacity: 0.85;
    font-size: 15px;
  }
  .lab-art {
    flex: none;
    width: 110px;
  }
  @media (max-width: 420px) {
    .lab-art {
      display: none;
    }
  }
</style>
