{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "sound-system-lab.vercel.app" }],
      "destination": "https://unmute-please.vercel.app/:path*",
      "statusCode": 301
    }
  ]
}
